@page "/AgendarAula"
@page "/AgendarAula/{id:int}"

@using GinasioVitaFit.Shared.Models;
@using GinasioVitaFit.Shared.Services;

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IGinasioVitaFitService VitaFitDbContext;

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary"><b>Agendar Aulas</b></MudText>
    
    <MudDataGrid Items="@_listaAulas1" Filterable="true" SortMode="SortMode.Multiple" QuickFilter="@FiltroGlobal">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Horário de Aulas Disponiveis</MudText>
            <MudSpacer />
            <!-- Campo de Pesquisa Rápida -->
            <MudTextField @bind-Value="_pesquisa" Placeholder="Pesquisar por modalidade, instrutor ou sala..." 
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0"
                          Clearable="true" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Modalidade" Title="Modalidade" />
            <PropertyColumn Property="x => x.Instrutor" Title="Instrutor" />
            <PropertyColumn Property="x => x.Sala" Title="Sala / Espaço" />
            <PropertyColumn Property="x => x.Capacidade" Title="Capacidade Máz." />

            <!-- Formatação das Datas/Horas para o utilizador ler facilmente -->
            <TemplateColumn Title="Início">
                <CellTemplate>
                    @context.Item.Inicio.ToString("dd/MM/yyyy HH:mm")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Fim">
                <CellTemplate>
                    @context.Item.Fim.ToString("HH:mm")
                </CellTemplate>
            </TemplateColumn>

            <!-- Coluna de Ações (Eliminar de forma lógica com o campo Delete) -->
            <TemplateColumn Title="Ações" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Error"
                                   OnClick="@(() => AdicionarAula(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>

    <MudDataGrid Items="@_listaAulas2" Filterable="true" SortMode="SortMode.Multiple" QuickFilter="@FiltroGlobal">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Horário de Aulas Agendadas</MudText>
            <MudSpacer />
            <!-- Campo de Pesquisa Rápida -->
            <MudTextField @bind-Value="_pesquisa" Placeholder="Pesquisar por modalidade, instrutor ou sala..." 
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0"
                      Clearable="true" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Modalidade" Title="Modalidade" />
            <PropertyColumn Property="x => x.Instrutor" Title="Instrutor" />
            <PropertyColumn Property="x => x.Sala" Title="Sala / Espaço" />
            <PropertyColumn Property="x => x.Capacidade" Title="Capacidade Máz." />

            <!-- Formatação das Datas/Horas para o utilizador ler facilmente -->
            <TemplateColumn Title="Início">
                <CellTemplate>
                    @context.Item.Inicio.ToString("dd/MM/yyyy HH:mm")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Fim">
                <CellTemplate>
                    @context.Item.Fim.ToString("HH:mm")
                </CellTemplate>
            </TemplateColumn>

            <!-- Coluna de Ações (Eliminar de forma lógica com o campo Delete) -->
            <TemplateColumn Title="Ações" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Size="Size.Small"
                               Icon="@Icons.Material.Filled.ExitToApp"
                               Color="Color.Warning"
                               OnClick="@(() => DesistirAula(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudContainer>
@code {
    [Parameter]
    public int? Id { get; set; } 
    
    private List<Aula> _listaAulas1 = new List<Aula>();
    private List<Aula> _listaAulas2 = new List<Aula>();
    
    private string _pesquisa = "";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var aulas = await VitaFitDbContext.GetAulas();
        
        if (aulas.IsSuccessful)
        {
            _listaAulas1 = aulas.Content ?? new List<Aula>();
        }
        else
        {
            // Dados fictícios para demonstração
            _listaAulas1 = new List<Aula>
            {
                new Aula { AulaID= 1, Modalidade = "Pilates", Instrutor = "Maria Silva", Sala = "Estúdio A", Capacidade = 15, Inicio = DateTime.Today.AddHours(9), Fim = DateTime.Today.AddHours(10), Delete = false },
                new Aula { AulaID = 2, Modalidade = "Crossfit", Instrutor = "João Santos", Sala = "Box Principal", Capacidade = 20, Inicio = DateTime.Today.AddHours(11), Fim = DateTime.Today.AddHours(12), Delete = false },
                new Aula { AulaID = 3, Modalidade = "Zumba", Instrutor = "Ana Costa", Sala = "Estúdio B", Capacidade = 30, Inicio = DateTime.Today.AddHours(18), Fim = DateTime.Today.AddHours(19), Delete = false }
            };
            
        }

        if (Id != null)
        {
            
        }
    }

    private bool FiltroGlobal(Aula aula)
    {
        if (string.IsNullOrWhiteSpace(_pesquisa)) return true;
        if (aula.Modalidade?.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (aula.Instrutor?.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (aula.Sala?.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        return false;
    }

    private async Task AdicionarAula(Aula aula)
    {
        var parameters = new DialogParameters<MudMessageBox>();
        
        var mbox = new MessageBoxOptions
        {
            Title = "Adicionar Aula",
            Message = $"Tem a certeza que deseja adicionar a aula de {aula.Modalidade} á sua agenda?",
            YesText = "Sim",
            CancelText = "Cancelar"
        };
    
        parameters.Add(x => x.MarkupMessage, new Microsoft.AspNetCore.Components.MarkupString(mbox.Message));
        parameters.Add(x => x.YesText, mbox.YesText);
        parameters.Add(x => x.CancelText, mbox.CancelText);
        
        var dialog = await DialogService.ShowAsync<MudMessageBox>(mbox.Title, parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is bool confirmar && confirmar)
        {
            AulaSocios aulaSocios = new AulaSocios
            {
                AulaID = aula.AulaID,
                Id = Id.Value,
                IsDeleted = false
            };
            
            
            var aulas = await VitaFitDbContext.AddSocioToAula(aulaSocios);

            if (aulas.IsSuccessful)
            {
                Snackbar.Add("Aula Adicionada com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Ocorreu um Erro na Adição da Aula!", Severity.Error);
            }
            
        }
        Snackbar.Add("Ocorreu um Erro na Adição da Aula!", Severity.Error);
    }

    

    private async Task DesistirAula(Aula aula)
    {
        var parameters = new DialogParameters<MudMessageBox>();
        
        var mbox = new MessageBoxOptions
        {
            Title = "Desistir Aula",
            Message = $"Tem a certeza que deseja desistir da aula de {aula.Modalidade}?",
            YesText = "Sim",
            CancelText = "Não"
        };
    
        parameters.Add(x => x.MarkupMessage, new Microsoft.AspNetCore.Components.MarkupString(mbox.Message));
        parameters.Add(x => x.YesText, mbox.YesText);
        parameters.Add(x => x.CancelText, mbox.CancelText);
        
        var dialog = await DialogService.ShowAsync<MudMessageBox>(mbox.Title, parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is bool confirmar && confirmar)
        {
            
            AulaSocios aulaSocios = new AulaSocios
            {
                AulaID = aula.AulaID,
                Id = Id.Value,
                IsDeleted = false
            };
            
            var aulas = await VitaFitDbContext.DeleteSocio_Soft(aulaSocios);

            if (aulas.IsSuccessful)
            {
                Snackbar.Add("Aula Desistida com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Ocorreu um Erro na desistencia da Aula!", Severity.Error);
            }
            
        }
        Snackbar.Add("Ocorreu um Erro na desistencia da Aula!", Severity.Error);
    }
}