@page "/AgendarAula"

@using System.Diagnostics
@using GinasioVitaFit.Shared.Models;
@using GinasioVitaFit.Shared.Services;

@rendermode InteractiveServer

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IGinasioVitaFitService VitaFitDbContext;

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-5" >
    <MudText Typo="Typo.h4" Class="mb-4" Color="Color.Primary"><b>Agendar Aulas</b></MudText>
    <MudItem xs="12" sm="4">
        <MudSelect T="Socio" ValueChanged="OnValueChanged"  Label="Socios" Placeholder="Escolha um Sócio." Required="true">
            @foreach (Socio selectItem in _listaSocios)
            {
                <MudSelectItem T="Socio" Value="@(selectItem)">@selectItem.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudDataGrid Items="@_listaAulas1" Filterable="true" SortMode="SortMode.Multiple"Class="mb-5" QuickFilter="@FiltroGlobal">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Horário de Aulas Disponiveis</MudText>
            <MudSpacer />
            <!-- Campo de Pesquisa Rápida -->
            <MudTextField @bind-Value="_pesquisa" Placeholder="Pesquisar por modalidade, instrutor ou sala..." 
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0"
                          Clearable="true" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Modalidade.Name" Title="Modalidade" />
            <PropertyColumn Property="x => x.Instrutor.Name" Title="Instrutor" />
            <PropertyColumn Property="x => x.Sala.Name" Title="Sala / Espaço" />
            <PropertyColumn Property="x => x.Capacidade" Title="Capacidade Máz." />

            <!-- Formatação das Datas/Horas para o utilizador ler facilmente -->
            <TemplateColumn Title="Início">
                <CellTemplate>
                    @context.Item.Inicio.ToString("dd/MM/yyyy HH:mm")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Fim">
                <CellTemplate>
                    @context.Item.Fim.ToString("HH:mm")
                </CellTemplate>
            </TemplateColumn>

            <!-- Coluna de Ações (Eliminar de forma lógica com o campo Delete) -->
            <TemplateColumn Title="Ações" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Success"
                                   OnClick="@(() => AdicionarAula(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>

    <MudDataGrid Items="@_listaAulas2" Filterable="true" SortMode="SortMode.Multiple" QuickFilter="@FiltroGlobal">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Horário de Aulas Agendadas</MudText>
            <MudSpacer />
            <!-- Campo de Pesquisa Rápida -->
            <MudTextField @bind-Value="_pesquisa" Placeholder="Pesquisar por modalidade, instrutor ou sala..." 
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mt-0"
                          Clearable="true" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Modalidade.Name" Title="Modalidade" />
            <PropertyColumn Property="x => x.Instrutor.Name" Title="Instrutor" />
            <PropertyColumn Property="x => x.Sala.Name" Title="Sala / Espaço" />
            <PropertyColumn Property="x => x.Capacidade" Title="Capacidade Máz." />

            <!-- Formatação das Datas/Horas para o utilizador ler facilmente -->
            <TemplateColumn Title="Início">
                <CellTemplate>
                    @context.Item.Inicio.ToString("dd/MM/yyyy HH:mm")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Fim">
                <CellTemplate>
                    @context.Item.Fim.ToString("HH:mm")
                </CellTemplate>
            </TemplateColumn>

            <!-- Coluna de Ações (Eliminar de forma lógica com o campo Delete) -->
            <TemplateColumn Title="Ações" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Filled.ExitToApp"
                                   Color="Color.Warning"
                                   OnClick="@(() => DesistirAula(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudContainer>

@code {
    public int Id { get; set; }

    private List<Aula> _listaAulas1 = new List<Aula>();
    private List<Aula> _listaAulas2 = new List<Aula>();
    
    private List<Socio> _listaSocios = new List<Socio>();
    private Socio _socio;
    private string _pesquisa = "";

    protected override async Task OnInitializedAsync()
    {
        await GetAllLists();
        
        await base.OnInitializedAsync();
    }

    private async Task GetAllLists()
    {
        var aulas = await VitaFitDbContext.GetAulas();
        
        if (aulas.IsSuccessful)
        {
            _listaAulas1 = aulas.Content ?? new List<Aula>();
        }      
        
        var socios = await VitaFitDbContext.GetSocios();
        _listaSocios = socios.Content ?? new List<Socio>();
    }

    private bool FiltroGlobal(Aula aula)
    {
        if (string.IsNullOrWhiteSpace(_pesquisa)) return true;
        if (aula.Modalidade?.Name.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (aula.Instrutor?.Name.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (aula.Sala?.Name.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        return false;
    }

    private async Task AdicionarAula(Aula aula)
    {
        var parameters = new DialogParameters<MudMessageBox>();

        var mbox = new MessageBoxOptions
        {
            Title = "Adicionar Aula",
            Message = $"Tem a certeza que deseja adicionar a aula de {aula.Modalidade.Name} á sua agenda?",
            YesText = "Sim",
            CancelText = "Cancelar"
        };

        parameters.Add(x => x.MarkupMessage, new Microsoft.AspNetCore.Components.MarkupString(mbox.Message));
        parameters.Add(x => x.YesText, mbox.YesText);
        parameters.Add(x => x.CancelText, mbox.CancelText);

        var dialog = await DialogService.ShowAsync<MudMessageBox>(mbox.Title, parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmar && confirmar)
        {
            AulaSocios aulaSocios = new AulaSocios
            {
                AulaId = aula.Id,
                SocioId = Id,
                IsDeleted = false,
                CreatedDate = DateTime.UtcNow,
                UpdatedDate = DateTime.UtcNow
            };


            var aulas = await VitaFitDbContext.AddSocioToAula(aulaSocios);

            
            if (aulas.IsSuccessful)
            {
                Snackbar.Add("Aula Adicionada com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Ocorreu um Erro na Adição da Aula1!", Severity.Error);
            }

        }
        else
        {
            Snackbar.Add("Ocorreu um Erro na Adição da Aula2!", Severity.Error);
        }
        
        UpdateLists();
        StateHasChanged();
    }



    private async Task DesistirAula(Aula aula)
    {
        var parameters = new DialogParameters<MudMessageBox>();

        var mbox = new MessageBoxOptions
        {
            Title = "Desistir Aula",
            Message = $"Tem a certeza que deseja desistir da aula de {aula.Modalidade.Name}?",
            YesText = "Sim",
            CancelText = "Não"
        };

        parameters.Add(x => x.MarkupMessage, new Microsoft.AspNetCore.Components.MarkupString(mbox.Message));
        parameters.Add(x => x.YesText, mbox.YesText);
        parameters.Add(x => x.CancelText, mbox.CancelText);

        var dialog = await DialogService.ShowAsync<MudMessageBox>(mbox.Title, parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is bool confirmar && confirmar)
        {

            AulaSocios aulaSocios = new AulaSocios
            {
                AulaId = aula.Id,
                SocioId = Id,
                IsDeleted = false
            };

            var aulas = await VitaFitDbContext.DeleteSocio_Soft(aulaSocios);

            if (aulas.IsSuccessful)
            {
                Snackbar.Add("Aula Desistida com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Ocorreu um Erro na desistencia da Aula!", Severity.Error);
            }

        }
        else
        {
            Snackbar.Add("Ocorreu um Erro na desistencia da Aula!", Severity.Error);
        }

        UpdateLists();
        StateHasChanged();
    }

    private async void OnValueChanged(Socio s)
    {
        Id = s.Id;
        UpdateLists();
    }

    private async void UpdateLists()
    {
        _listaAulas2.Clear();
        
        var aulas = await VitaFitDbContext.GetAulas();
        _listaAulas1 = aulas.Content ?? new List<Aula>();
        
        var aulas2 = await VitaFitDbContext.GetAllAulasFromSocio(Id);
        var aulsocios = aulas2.Content ?? new List<AulaSocios>();

        if (aulsocios != null)
        {
            foreach (AulaSocios aulsoc in aulsocios)
            {

                var aula1 = await VitaFitDbContext.GetAula(aulsoc.AulaId);
                Aula _aula = aula1.Content ?? new Aula(); 
                _listaAulas2.Add(_aula);

            }

            foreach (Aula aul in _listaAulas2)
            {
                for (int i = 0; i < _listaAulas1.Count; i++)
                {
                    if ((_listaAulas1[i].Modalidade.Name == aul.Modalidade.Name) &&
                        (_listaAulas1[i].Instrutor.Name == aul.Instrutor.Name) &&
                        (_listaAulas1[i].Sala.Name == aul.Sala.Name))
                    {
                        _listaAulas1.RemoveAt(i);
                    }
                }
            }
                
        }
        StateHasChanged();
    }
}