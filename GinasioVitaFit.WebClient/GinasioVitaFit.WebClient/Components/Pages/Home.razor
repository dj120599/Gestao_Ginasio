@page "/"
@using MudBlazor
@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-6" Color="Color.Primary"><b>Dashboard Geral VitaFit</b></MudText>

    <!-- 1. Linha de Indicadores Rápidos (KPIs) -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4 d-flex align-center justify-space-between rounded-lg" Elevation="3" Style="background: linear-gradient(135deg, #1E88E5, #1565C0); color: white;">
                <div>
                    <MudText Typo="Typo.subtitle1">Sócios Ativos</MudText>
                    <MudText Typo="Typo.h3"><b>@totalSociosAtivos</b></MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.CardMembership" Style="font-size: 3rem; opacity: 0.5;" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4 d-flex align-center justify-space-between rounded-lg" Elevation="3" Style="background: linear-gradient(135deg, #4CAF50, #2E7D32); color: white;">
                <div>
                    <MudText Typo="Typo.subtitle1">Total de Aulas</MudText>
                    <MudText Typo="Typo.h3"><b>@totalAulas</b></MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="font-size: 3rem; opacity: 0.5;" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4 d-flex align-center justify-space-between rounded-lg" Elevation="3" Style="background: linear-gradient(135deg, #FF9800, #E65100); color: white;">
                <div>
                    <MudText Typo="Typo.subtitle1">Ocupação Média</MudText>
                    <MudText Typo="Typo.h3"><b>@taxaOcupacaoMedia%</b></MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="font-size: 3rem; opacity: 0.5;" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <!-- Top 5 Aulas - Maior Ocupação -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 rounded-lg" Elevation="3">
                <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary"><b>Top 5 Aulas - Maior Ocupação</b></MudText>
                <MudSimpleTable Style="overflow-x: auto;">
                    <thead>
                    <tr>
                        <th>Modalidade</th>
                        <th>Inscrições / Vagas</th>
                        <th>Taxa %</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var aula in topAulas)
                    {
                    <tr>
                        <td>@aula.Nome</td>
                        <td>@aula.Inscritos / @aula.Capacidade</td>
                        <td>
                            <MudProgressLinear Color="@aula.Cor" Value="@aula.Percentagem" Class="my-2" Size="Size.Medium" />
                            <MudText Typo="Typo.caption"><b>@aula.Percentagem%</b></MudText>
                        </td>
                    </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <!-- Inscrições por Modalidade (Gráfico Donut) -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 rounded-lg" Elevation="3">
                <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary"><b>Inscrições por Modalidade</b></MudText>
                <MudChart T="double"
                          ChartType="ChartType.Donut"
                          Width="300px"
                          Height="300px"
                          InputData="@graficoDados"
                          InputLabels="@graficoEtiquetas">
                    <CustomGraphics>
                        <text class="donut-title" x="40%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" style="font-size: 14px; font-weight: bold;">Total</text>
                        <text class="donut-sub" x="40%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="gray" style="font-size: 18px; font-weight: bold;">@VerObterSoma()</text>
                    </CustomGraphics>
                </MudChart>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int totalSociosAtivos = 142;
    private int totalAulas = 40;
    private int taxaOcupacaoMedia = 68;

    private double[] graficoDados = { 120, 95, 80, 55, 40 };
    private string[] graficoEtiquetas = { "Musculação", "Crossfit", "Zumba", "Pilates", "Ciclismo" };

    private List<AulaOcupacao> topAulas = new()
    {
        new() { Nome = "Crossfit (Seg 11:00)", Inscritos = 14, Capacidade = 15, Percentagem = 93, Cor = Color.Error },
        new() { Nome = "Musculação (Ter 09:00)", Inscritos = 18, Capacidade = 20, Percentagem = 90, Cor = Color.Success },
        new() { Nome = "Zumba (Qua 15:00)", Inscritos = 26, Capacidade = 30, Percentagem = 86, Cor = Color.Info },
        new() { Nome = "Ciclismo (Sex 19:00)", Inscritos = 21, Capacidade = 25, Percentagem = 84, Cor = Color.Warning },
        new() { Nome = "Pilates (Qui 17:00)", Inscritos = 9, Capacidade = 12, Percentagem = 75, Cor = Color.Primary }
    };

    private string VerObterSoma()
    {
        return "390";
    }

    public class AulaOcupacao
    {
        public string Nome { get; set; } = "";
        public int Inscritos { get; set; }
        public int Capacidade { get; set; }
        public int Percentagem { get; set; }
        public Color Cor { get; set; }
    }

}