@page "/modalidades"
@using GinasioVitaFit.Shared.Services
@using GinasioVitaFit.Shared.Models
@inject IGinasioVitaFitService GinasioVitaFitService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@using GinasioVitaFit.WebClient.Components.Pages.Modalidades.Componentes

<h1 class="text-3xl font-bold mb-6">
    Modalidades
</h1>

<button @onclick="AbrirModal"
        class="bg-amber-500! hover:bg-amber-600! text-white px-4 py-2 rounded-lg transition-colors duration-300">
    Nova Modalidade
</button>


<div class="w-full h-125 overflow-y-auto mt-3">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        @foreach (var modalidade in _modalidades)
        {
            <div
                class="group flex flex-col xl:flex-row bg-white rounded-2xl 
                        shadow-sm border border-slate-100 overflow-hidden xl:h-44
                        w-full max-w-xl">

                <div class="w-full h-48 xl:w-2/5 xl:h-44 shrink-0">
                    <img
                        src="@modalidade.ImageUrl"
                        alt="@modalidade.Id"
                        class="w-full h-full object-cover 
                            transition-transform duration-300 group-hover:scale-105"/>
                </div>

                <div class="w-full xl:w-3/5 p-4 flex flex-col justify-between">

                    <div class="flex items-center justify-between">
                        <span class="flex flex-row items-center gap-2 text-xs  whitespace-nowrap">
                            <MudIcon
                                Icon="@Icons.Material.TwoTone.CalendarMonth"
                                class="text-amber-500"/>
                            <p class="m-0 text-slate-400">09 jul. 2026</p>
                        </span>
                        <span
                            class="flex flex-row items-center leading-none gap-1 px-3 py-1 
                                    text-[10px] text-amber-500 bg-amber-500/15 rounded-full
                                    uppercase tracking-wider">
                            <MudIcon
                                Icon="@Icons.Material.Outlined.WorkspacePremium"
                                class="inline-block"/>
                            <p class="m-0 text-amber-600 font-semibold">@modalidade.Dificuldade.Name</p>
                        </span>
                    </div>

                    <div class="my-auto">
                        <h3 class="text-xl font-bold text-slate-800 capitalize leading-tight">
                            @modalidade.Name
                        </h3>
                        <p class="text-xs font-medium text-slate-400 mt-0.5">
                            @modalidade.Description
                        </p>
                    </div>

                    <div class="flex justify-end">
                        <button
                            @onclick="() => OnDeleteModalidade(modalidade.Id)"
                            class="p-1 rounded-lg text-slate-700 hover:bg-gray-100!
                                hover:text-blue-600 transition-colors">
                            <MudIcon
                                Icon="@Icons.Material.Outlined.Delete"
                                class="text-red-600"/>
                        </button>
                    </div>

                </div>
            </div>
        }

    </div>
</div>



<AddModalidadeComponente
    @ref="_modal"
    ImagensExistentes="_imagensExistentes"
    ModalidadeAdded="CarregarDados"
/>

@code {
    private AddModalidadeComponente? _modal;

    private List<Modalidade> _modalidades = new();
    private List<string> _imagensExistentes = new();
    
    private async Task CarregarDados()
    {
        var modalidades = await GinasioVitaFitService.GetAllModalidades();

        if (modalidades.IsSuccessStatusCode)
        {
            _modalidades = (modalidades.Content ?? new List<Modalidade>())
                .Where(m => !m.IsDeleted)
                .ToList();

            _imagensExistentes = _modalidades
                .Where(m =>
                    !string.IsNullOrEmpty(m.ImageUrl)
                    && !m.ImageUrl.Contains("placeholder")
                    && m.ImageUrl != "something")
                .Select(m => m.ImageUrl)
                .Distinct()
                .ToList();
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await CarregarDados();
    }

    private async Task AbrirModal()
    {
        await _modal!.Show();
    }

    private async Task OnDeleteModalidade(int id)
    {
        try
        {
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };

            bool? resultConfirm = await DialogService.ShowMessageBoxAsync(
                "Eliminar Modalidade?",
                "Tem a certeza que deseja eliminar esta modalidade?",
                yesText: "Sim, Eliminar",
                cancelText: "Não, Cancelar",
                options: options);

            if (resultConfirm != true) return;

            var result = await GinasioVitaFitService.DeleteModalidade_Soft(id);

            if (result.IsSuccessStatusCode)
            {
                Snackbar.Add("Modalidade eliminada com sucesso!", Severity.Success, config =>
                {
                    config.VisibleStateDuration = 1500;
                    config.HideTransitionDuration = 200;
                });

                await CarregarDados();
            }
            else
            {
                Snackbar.Add("Não foi possível eliminar a modalidade.", Severity.Error);
            }
        }
        catch (Exception e)
        {
            Snackbar.Add($"Erro ao eliminar: {e.Message}", Severity.Error);
        }
    }

}