@using GinasioVitaFit.Shared.Services
@using GinasioVitaFit.Shared.Models
@inject IGinasioVitaFitService GinasioVitaFitService
@inject ISnackbar Snackbar
@* @inject NavigationManager NavigationManager *@


@if (_isOpen)
{
    <div class="@OverlayClass">

        <div class="@ModalClass bg-white rounded-xl shadow-xl w-full max-w-3xl mx-4 overflow-hidden"
             @onclick:stopPropagation>

            @if (_isLoading)
            {
                <div class="flex flex-col items-center justify-center py-20">

                    <div
                        class="w-12 h-12 border-4 border-amber-500 border-t-transparent rounded-full animate-spin"></div>

                    <p class="mt-4 text-gray-500">
                        A carregar...
                    </p>

                </div>
            }
            else
            {
                <div class="max-h-[90vh] overflow-y-auto">

                    <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">

                        <h3 class="text-2xl font-bold text-gray-800!">
                            Adicionar Modalidade
                        </h3>

                        <button
                            @onclick="Hide"
                            class="p-2 text-amber-500! rounded-lg hover:bg-gray-100! hover:text-amber-700! transition cursor-pointer">

                            <MudIcon Icon="@Icons.Material.Filled.Close" class="text-xl!"/>
                            @* <span class="bi bi-x-lg text-xl"></span> *@
                        </button>

                    </div>
                    <div class="p-6! overflow-y-auto max-h-[70vh]">
                        <EditForm Model="_modalidade" FormName="modalidadeForm" OnValidSubmit="OnAddModalidade">
                            <DataAnnotationsValidator/>

                            <div class="flex flex-col gap-4 p-6">

                                <div class="flex flex-col gap-1">
                                    <label class="text-sm font-medium text-gray-700">Nome</label>
                                    <InputText
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
                                        @bind-Value="_modalidade.Name"/>
                                    <ValidationMessage For="() => _modalidade.Name" class="text-xs text-red-500"/>
                                </div>

                                <div class="flex flex-col gap-1">
                                    <label class="text-sm font-medium text-gray-700">Descrição</label>
                                    <InputTextArea
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white min-h-20"
                                        @bind-Value="_modalidade.Description"/>
                                    <ValidationMessage For="() => _modalidade.Description"
                                                       class="text-xs text-red-500"/>
                                </div>

                                <div class="flex flex-col gap-1">
                                    <label class="text-sm font-medium text-gray-700">Dificuldade</label>
                                    <InputSelect
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
                                        @bind-Value="_modalidade.DificuldadeId">
                                        <option value="0">Selecione a dificuldade...</option>
                                        @foreach (var dif in _dificuldades)
                                        {
                                            <option value="@dif.Id">@dif.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => _modalidade.DificuldadeId"
                                                       class="text-xs text-red-500"/>
                                </div>

                                <div class="flex flex-col gap-1 mt-2">
                                    <label class="text-sm font-medium text-gray-700">Imagem da Modalidade</label>

                                    <label
                                        class="w-full min-h-40 border-2 border-dashed border-gray-300 hover:border-amber-500 bg-gray-50 rounded-xl flex flex-col items-center justify-center p-4 cursor-pointer transition-all duration-200 group relative">
                                        <InputFile OnChange="OnImageFileChanged" accept=".png, .jpg, .jpeg"
                                                   class="hidden"
                                                   disabled="@_isUploading"/>

                                        @if (_isUploading)
                                        {
                                            <!-- ESTADO DE ESPERA: Spinner Animado com Tailwind -->
                                            <div class="flex flex-col items-center justify-center gap-2">
                                                <div
                                                    class="w-8 h-8 border-4 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
                                                <p class="text-sm font-medium text-amber-600 animate-pulse">A
                                                    processar
                                                    imagem
                                                    pesada...</p>
                                            </div>
                                        }
                                        else if (string.IsNullOrEmpty(_modalidade.ImageUrl) || _modalidade.ImageUrl.Contains("placeholder"))
                                        {
                                            <!-- Estado 1: Sem Imagem (Mostra a zona de upload) -->
                                            <span
                                                class="bi bi-cloud-arrow-up text-gray-400 group-hover:text-amber-500 text-4xl transition-colors mb-2"></span>
                                            <p class="text-sm font-semibold text-gray-600 group-hover:text-amber-600">
                                                Clique
                                                para
                                                carregar a
                                                imagem</p>
                                            <p class="text-xs text-gray-400 mt-1">Formatos aceites: PNG, JPG ou
                                                JPEG</p>
                                        }
                                        else
                                        {
                                            <!-- Estado 2: Com Imagem Carregada -->
                                            <div class="flex flex-col items-center gap-2">
                                                <!-- O HTML lê diretamente a variável de preview purificada -->
                                                <img src="@_previewUrl"
                                                     alt="@_previewUrl"
                                                     class="max-h-36 w-auto rounded-lg shadow-sm border border-gray-200 object-contain bg-white p-1"/>

                                                <div class="flex items-center gap-2 mt-1">
                                                <span
                                                    class="text-xs text-emerald-600 font-medium flex items-center gap-1 bg-emerald-50 px-2 py-0.5 rounded-xs">
                                                    <span class="bi bi-check-circle-fill"></span> Imagem Carregada
                                                </span>
                                                    <button type="button" @onclick="LimparImagemManualmente"
                                                            @onclick:stopPropagation="true"
                                                            class="text-xs text-red-600 font-medium bg-red-50 hover:bg-red-100 px-2 py-0.5 rounded-xs transition-colors cursor-pointer">
                                                        Remover
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </label>

                                    @if (ImagensExistentes.Any())
                                    {
                                        <div class="mt-3">
                                        <span
                                            class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1">Ou escolha uma imagem do servidor:</span>

                                            <!-- Garantimos o flex-row e o overflow-x-auto para a linha horizontal voltar -->
                                            <div
                                                class="flex flex-row gap-2 overflow-x-auto py-3 px-2 bg-gray-50 rounded-lg border border-gray-100 overflow-y-visible">
                                                @foreach (var imgPath in ImagensExistentes)
                                                {
                                                    bool isSelected = _modalidade.ImageUrl == imgPath;
                                                    string nomeFicheiro = imgPath.Contains("/") ? imgPath.Split('/').Last() : imgPath;

                                                    <!-- Classe inline-block força o tooltip a ficar colado ao botão -->
                                                    <MudTooltip Text="@nomeFicheiro" Arrow="true"
                                                                Placement="Placement.Bottom"
                                                                RootClass="inline-block flex-shrink-0">
                                                        <ChildContent>

                                                            <button type="button"
                                                                    @onclick="() => SelecionarImagemExistente(imgPath)"
                                                                    class="w-16 h-16 rounded-lg border-2 transition-all bg-white p-0.5 cursor-pointer shadow-xs focus:outline-none
                                       @(isSelected ? "border-amber-500 ring-2 ring-amber-500/75 scale-105" : "border-gray-200 hover:border-amber-400 hover:scale-105")">

                                                                <img
                                                                    src="@(imgPath.StartsWith("/uploads") ? $"https://localhost:7134{imgPath}" : imgPath)"
                                                                    alt="@imgPath"
                                                                    class="w-full h-full object-cover rounded-md pointer-events-none"/>

                                                            </button>

                                                        </ChildContent>
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                @* <ValidationSummary class="text-sm text-red-600 list-disc pl-5" /> *@

                                <button type="submit"
                                        disabled="@(_saveState != SaveState.Idle)"
                                        class="@LoadingSave @ButtonCursor mt-2 w-1/3 text-white font-semibold 
                                            py-2 px-4 rounded-lg transition-all duration-300
                                            flex items-center justify-center gap-2 self-center">

                                    @if (_saveState == SaveState.Idle)
                                    {
                                        <span>Adicionar</span>
                                    }
                                    else if (_saveState == SaveState.Saving)
                                    {
                                        <span
                                            class="w-5 h-5 border-2! border-white! 
                                                border-t-transparent!
                                                rounded-full animate-spin"></span>
                                        <span>A guardar...</span>
                                    }
                                    else if (_saveState == SaveState.Saved)
                                    {
                                        <MudIcon
                                            Icon="@Icons.Material.Filled.Check"
                                            class="text-white! w-5! h-5!"/>
                                        <span>Guardado!</span>
                                    }

                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>

    </div>
}

@code {
    [Parameter] public List<string> ImagensExistentes { get; set; } = new();

    [Parameter] public EventCallback ModalidadeAdded { get; set; }

    private bool _isOpen;
    private bool _isAnimating;
    private bool _isLoading;
    private bool _loaded;

    private enum SaveState
    {
        Idle,
        Saving,
        Saved
    }

    private SaveState _saveState = SaveState.Idle;

    private Modalidade _modalidade = new();
    private List<Dificuldade> _dificuldades = new();

    private string _previewUrl = "/images/modalidade-placeholder.png";
    private bool _isUploading;

    private string OverlayClass =>
        $"fixed inset-0 z-50 flex items-center justify-center bg-black/50 transition-opacity duration-300 " +
        $"{(_isAnimating ? "opacity-100" : "opacity-0")}";

    private string ModalClass =>
        $"transition-all duration-300 ease-out " +
        $"{(_isAnimating
            ? "opacity-100 scale-100 translate-y-0"
            : "opacity-0 scale-95 translate-y-6")}";

    private string LoadingSave =>
        $"{(_saveState == SaveState.Idle ? "bg-amber-500! hover:bg-amber-600!" : "")}" +
        $"{(_saveState == SaveState.Saving ? "bg-amber-300!" : "")}" +
        $"{(_saveState == SaveState.Saved ? "bg-emerald-400!" : "")}";

    private string ButtonCursor =>
        _saveState == SaveState.Idle
            ? "cursor-pointer"
            : "cursor-not-allowed";

    public async Task Show()
    {
        _saveState = SaveState.Idle;

        _isOpen = true;
        _isLoading = true;
        _isAnimating = true;

        StateHasChanged();

        if (!_loaded)
        {
            await CarregarDados();
            _loaded = true;
        }

        _isLoading = false;

        StateHasChanged();
    }

    public async Task Hide()
    {
        _isAnimating = false;
        StateHasChanged();

        await Task.Delay(300);

        _isOpen = false;

        _modalidade = new();
        _previewUrl = "/images/modalidade-placeholder.png";

        StateHasChanged();
    }

    private async Task CarregarDados()
    {
        var dificuldades = await GinasioVitaFitService.GetAllDificuldades();

        if (dificuldades.IsSuccessStatusCode)
            _dificuldades = dificuldades.Content ?? new List<Dificuldade>();
    }

    private async Task OnAddModalidade()
    {
        try
        {
            _saveState = SaveState.Saving;

            await GinasioVitaFitService.AddModalidade(_modalidade);

            _saveState = SaveState.Saved;

            Snackbar.Add("Modalidade guardada com sucesso!", Severity.Success, config =>
            {
                config.VisibleStateDuration = 1500;
                config.HideTransitionDuration = 200;
            });

            await ModalidadeAdded.InvokeAsync();

            await Task.Delay(1500);

            await Hide();
        }
        catch (Exception ex)
        {
            _saveState = SaveState.Idle;

            Snackbar.Add($"Erro ao guardar modalidade: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnImageFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                _isUploading = true;
                StateHasChanged();

                long maxFileSize = 1024 * 1024 * 10; // Limite de 10MB para ficheiros pesados
                using var memoryStream = new MemoryStream();
                await file.OpenReadStream(maxFileSize).CopyToAsync(memoryStream);

                var buffer = memoryStream.ToArray();
                var base64String = Convert.ToBase64String(buffer);
                var base64Completo = $"data:{file.ContentType};base64,{base64String}";

                // 1. O HTML usa esta variável limpa para renderizar a imagem sem falhas
                _previewUrl = base64Completo;

                // 2. A propriedade que vai para a API guarda a tua estrutura com a barra |
                _modalidade.ImageUrl = $"{file.Name}|{base64Completo}";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao processar imagem: {ex.Message}");
            }
            finally
            {
                _isUploading = false;
                StateHasChanged();
            }
        }
    }

    private void LimparImagemManualmente()
    {
        _previewUrl = "/images/modalidade-placeholder.png";
        _modalidade.ImageUrl = "/images/modalidade-placeholder.png";
    }

    private void SelecionarImagemExistente(string caminhoImagem)
    {
        _modalidade.ImageUrl = caminhoImagem;

        // 2. Atualiza o ecrã com o caminho completo da API para a imagem aparecer na hora
        _previewUrl = caminhoImagem.StartsWith("/uploads")
            ? $"https://localhost:7134{caminhoImagem}"
            : caminhoImagem;
    }

}