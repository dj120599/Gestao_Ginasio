@page "/AulasPage"

@using GinasioVitaFit.Shared.Models
@using GinasioVitaFit.Shared.Services
@using GinasioVitaFit.WebClient.Components.Pages.Aulas.Componentes

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IGinasioVitaFitService GinasioService
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4" Color="Color.Warning">
        <b>Gestão de Aulas</b>
    </MudText>
    
    <!-- Botão Corrigido para abrir a vossa nova página de agendamento -->
    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="IrParaCriarAula" Class="mb-4">
        + NOVA AULA
    </MudButton>

    <MudDataGrid Items="@_listaAulas" Filterable="true" SortMode="SortMode.Multiple" QuickFilter="@FiltroGlobal"
                 Striped="true" Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Horário de Aulas</MudText>
            <MudSpacer/>

            <!-- Campo de _pesquisa Rápida -->
            <MudTextField @bind-Value="_pesquisa"
                          Placeholder="_pesquisar por modalidade, instrutor ou sala..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0"
                          Clearable="true"/>
        </ToolBarContent>
        
        <Columns>
            <!-- 1. Coluna Modalidade: Mostra o Nome se existir, senão mostra o ID -->
            <TemplateColumn Title="Modalidade">
                <CellTemplate>
                    @(context.Item.Modalidade?.Name ?? $"ID: {context.Item.ModalidadeId}")
                </CellTemplate>
            </TemplateColumn>

            <!-- 2. Coluna Instrutor: Mostra o Nome se existir, senão mostra o ID -->
            <TemplateColumn Title="Instrutor">
                <CellTemplate>
                    @(context.Item.Instrutor?.Name ?? $"ID: {context.Item.InstrutorId}")
                </CellTemplate>
            </TemplateColumn>

            <!-- 3. Coluna Sala: Mostra o Nome se existir, senão mostra o ID -->
            <TemplateColumn Title="Sala / Espaço">
                <CellTemplate>
                    @(context.Item.Sala?.Name ?? $"ID: {context.Item.SalaId}")
                </CellTemplate>
            </TemplateColumn>

            <!-- 4. Coluna Capacidade Máz. -->
            <PropertyColumn Property="x => x.Capacidade" Title="Capacidade Máz." Filterable="false"/>

            <!-- Formatação das Datas/Horas para o utilizador ler facilmente -->
            <!--
            <TemplateColumn Title="Início">
                <CellTemplate>
                    @context.Item.Inicio.ToString("dd/MM/yyyy HH:mm")
                </CellTemplate>
            </TemplateColumn>
            -->
            
            <TemplateColumn Title="Data">
                <CellTemplate>
                    @context.Item.Inicio.ToString("dd/MM/yyyy")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Início">
                <CellTemplate>
                    @context.Item.Inicio.ToString("HH:mm")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Fim">
                <CellTemplate>
                    @context.Item.Fim.ToString("HH:mm")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Aberto">
                <CellTemplate >
                    @if (context.Item.IsOpen)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Warning"/>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Close"  Color="Color.Warning"/>
                    }
                </CellTemplate>
            </TemplateColumn>

            <!-- Coluna de Ações (Eliminar de forma lógica com o campo Delete) -->
            <TemplateColumn Title="Ações" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Rounded.OpenInNew"
                                   OnClick="@(() => AbrirModalInfo(context.Item))" 
                                   Class="text-amber-500!"
                    />
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(() => ConfirmarEliminacao(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent >
            <div class="bg-warning">
                <MudDataGridPager Items="@_listaAulas"/>
            </div>
        </PagerContent>
    </MudDataGrid>
</MudContainer>

<AulaModalComponente 
    @ref="_modal"
/>

@code {
    private AulaModalComponente? _modal;
    private List<Aula> _listaAulas = new List<Aula>();
    private string _pesquisa = "";

    // 1. INJEÇÃO DO SERVIÇO: Garanta que colocou o '@inject IGinasioVitaFitService GinasioService' no topo do ficheiro!
    protected override async Task OnInitializedAsync()
    {
        await CarregarAulas();
        await base.OnInitializedAsync();
    }
    
    private async Task AbrirModalInfo(Aula aula)
    {
        await _modal!.Show(aula);
    }

    private async Task CarregarAulas()
    {
        try
        {
            // Faz a chamada e armazena na variável genérica dynamic para o C# não reclamar do tipo
            dynamic resposta = await GinasioService.GetAulas(); 
            
            if (resposta != null)
            {
                // Se o método devolver ApiResponse, extrai o .Content, senão usa os dados diretos
                _listaAulas = resposta.Content ?? resposta;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar aulas: {ex.Message}", Severity.Error);
            _listaAulas = new List<Aula>(); 
        }

        // Filtra as aulas que não foram eliminadas
        if (_listaAulas != null)
        {
            _listaAulas = _listaAulas.Where(a => !a.IsDeleted).ToList();
        }
        else
        {
            _listaAulas = new List<Aula>();
        }
        
        StateHasChanged();
    }

    // 3. CORREÇÃO DO BOTÃO AZUL: Mude a propriedade OnClick do botão "+ NOVA AULA" no HTML para chamar este método
    private void IrParaCriarAula()
    {
        Navigation.NavigateTo("/AddAula");
    }

    private bool FiltroGlobal(Aula aula)
    {
        if (string.IsNullOrWhiteSpace(_pesquisa)) return true;
        
        // 4. CORREÇÃO DOS FILTROS: Adaptado para ler as novas propriedades de navegação (.Name)
        if (aula.Modalidade?.Name?.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (aula.Instrutor?.Name?.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (aula.Sala?.Name?.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        
        return false;
    }

    private async Task ConfirmarEliminacao(Aula aula)
    {
        var parameters = new DialogParameters<MudMessageBox>();
        
        var mbox = new MudBlazor.MessageBoxOptions
        {
            Title = "Eliminar Aula",
            // Ajustado para .Modalidade.Name
            Message = $"Tem a certeza que deseja eliminar a aula de {aula.Modalidade?.Name}?",
            YesText = "Eliminar",
            CancelText = "Cancelar"
        };
    
        parameters.Add(x => x.MarkupMessage, new Microsoft.AspNetCore.Components.MarkupString(mbox.Message));
        parameters.Add(x => x.YesText, mbox.YesText);
        parameters.Add(x => x.CancelText, mbox.CancelText);
        
        var dialog = await DialogService.ShowAsync<MudMessageBox>(mbox.Title, parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is bool confirmar && confirmar)
        { 
            var aulas = await GinasioService.DeleteAula(aula.Id);
            
            if (aulas.IsSuccessful)
            {
                Snackbar.Add("Aula eliminada com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Ocorreu um Erro na eliminação da Aula!", Severity.Error);
            }
            await CarregarAulas();
        }
        
        await CarregarAulas();
    }

}