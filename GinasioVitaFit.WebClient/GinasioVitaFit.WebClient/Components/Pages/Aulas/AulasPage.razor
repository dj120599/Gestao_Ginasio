@page "/AulasPage"
@using GinasioVitaFit.Shared.Models
@using GinasioVitaFit.Shared.Services
@using GinasioVitaFit.WebClient.Components.Pages.Aulas.Componentes
@inject IGinasioVitaFitService GinasioService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

@* <MudThemeProvider Theme="@temaLaranja" /> *@
<MudSnackbarProvider/>

<div class="flex flex-col mb-8 gap-2">

    <!-- CABEÇALHO SUPERIOR LARANJA -->
    <div class="mb-6!">
        <div class="flex flex-col md:flex-row gap-y-2 justify-between md:items-start">
            <div class="flex flex-col">
                <h1 class="text-gray-800!">Aulas Marcadas</h1>
                <p class="m-0 text-gray-800! text-sm!">
                    Planeie o mapa de aulas e faça a gestão das vagas
                    disponíveis
                </p>
            </div>

            <button
                @onclick="AbrirModalAgendamento"
                class="flex items-center! justify-center! font-bold! gap-2 
                  bg-amber-500! hover:bg-amber-600! text-white px-8! py-3 rounded-lg 
                    shadow-md hover:shadow-lg transition-all duration-300">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"/>
                <p class="m-0">Marca Aula</p>
            </button>
        </div>
    </div>

    <!-- INJEÇÃO DO COMPONENTE ARTESANAL COM CAMINHO TRANCADO -->
    <AddAulasComponente
        @ref="modalAgendar"
        OnSubmetido="RecarregarGradeHorario"/>

    <!-- TABELA MAPA DE HORÁRIOS -->
    <MudDataGrid Items="@listaAulas" Filterable="true" SortMode="SortMode.Multiple">
        <Columns>
            <!-- 4. CORREÇÃO: Nova Coluna do InstrutorDto (Usa a propriedade estrangeira Name ou Nome do instrutorDto) -->
            <TemplateColumn Title="Instrutor">
                <CellTemplate>
                    @(context.Item.Instrutor != null ? context.Item.Instrutor.Name : $"Cód. {context.Item.InstrutorId}")
                </CellTemplate>
            </TemplateColumn>
            
            <!-- 3. CORREÇÃO: Nova Coluna da ModalidadeDto (Usa a propriedade estrangeira que o teu colega criou) -->
            <TemplateColumn Title="Modalidades">
                <CellTemplate>
                    @(context.Item.Modalidade != null ? context.Item.Modalidade.Name : $"Cód. {context.Item.ModalidadeId}")
                </CellTemplate>
            </TemplateColumn>
            
            <!-- 1. Data da Aula -->
            <TemplateColumn Title="Data">
                <CellTemplate>
                    @context.Item.Inicio.ToString("dd/MM/yyyy")
                </CellTemplate>
            </TemplateColumn>

            <!-- 2. Horário de Início e Fim -->
            <TemplateColumn Title="Horário">
                <CellTemplate>
                    @($"{context.Item.Inicio.ToString("HH:mm")} - {context.Item.Fim.ToString("HH:mm")}")
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Aberto">
                <CellTemplate>
                    @if (context.Item.IsOpen)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Warning"/>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Warning"/>
                    }
                </CellTemplate>
            </TemplateColumn>

            <!-- 6. Ações (Editar e Apagar) -->
            <TemplateColumn Sortable="false" Filterable="false">
                <CellTemplate>
                    <div class="d-flex gap-2 center">
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Outlined.Info"
                                       Class="text-gray-500!"
                                       OnClick="@(() => AbrirModalInfo(context.Item))"/>

                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Class="text-amber-500!"
                                       OnClick="@(() => modalAgendar.ShowEditar(context.Item))"/>

                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Delete"
                                       Class="text-rose-600!"
                                       OnClick="@(() => ExecutarEliminacaoReal(context.Item))"/>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <div class="bg-amber-500">
                <MudDataGridPager
                    Items="@listaAulas"
                    Class="font-bold! mud-table-pager-white"/>
            </div>
        </PagerContent>
    </MudDataGrid>
</div>

<AulaModalComponente
    @ref="_modal"
/>

@code {
    private AulaModalComponente? _modal;
    private List<AulaDto> listaAulas = new();
    private AddAulasComponente modalAgendar = default!;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAulas();
    }

    private async Task CarregarAulas()
    {
        try
        {
            var resposta = await GinasioService.GetAulas();
            if (resposta != null && resposta.IsSuccessStatusCode)
            {
                listaAulas = resposta.Content ?? new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Aviso de rede: {ex.Message}", Severity.Info);
        }
    }

    private async Task AbrirModalInfo(AulaDto aula)
    {
        await _modal!.Show(aula);
    }

    private async Task AbrirModalAgendamento()
    {
        await modalAgendar.Show();
    }

    private async Task RecarregarGradeHorario()
    {
        await Task.Delay(500);
        await CarregarAulas();
    }

    private async Task ExecutarEliminacaoReal(AulaDto Aula)
    {
        try
        {
            var parameters = new DialogParameters<MudMessageBox>();

            var mbox = new MessageBoxOptions
            {
                Title = "Desistir Aula",
                Message = $"Tem a certeza que deseja desistir da aula de {Aula.Modalidade.Name}?",
                YesText = "Sim",
                CancelText = "Não"
            };

            parameters.Add(x => x.MarkupMessage, new Microsoft.AspNetCore.Components.MarkupString(mbox.Message));
            parameters.Add(x => x.YesText, mbox.YesText);
            parameters.Add(x => x.CancelText, mbox.CancelText);

            var dialog = await DialogService.ShowAsync<MudMessageBox>(mbox.Title, parameters);
            var result = await dialog.Result;

            if (!result.Canceled && result.Data is bool confirmar && confirmar)
            {
                // 1. CHAMA O SERVICE REAL: Usa o método exato de apagar que está no teu IGinasioVitaFitService (ex: DeleteAula)
                var resposta = await GinasioService.DeleteAula(Aula.Id);

                if (resposta != null && resposta.IsSuccessStatusCode)
                {
                    Snackbar.Add("Aula cancelada com sucesso!", Severity.Success);


                    await Task.Delay(500);
                    await CarregarAulas();
                }
                else
                {
                    var erroTexto = resposta?.ReasonPhrase ?? "Erro desconhecido";
                    Snackbar.Add($"Erro ao cancelar: {erroTexto}", Severity.Error);
                    await CarregarAulas();
                }
            }
            else
            {
                Snackbar.Add("Ocorreu um Erro na desistencia da Aula!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro na eliminação: {ex.Message}", Severity.Error);
            await CarregarAulas();
        }
    }

}