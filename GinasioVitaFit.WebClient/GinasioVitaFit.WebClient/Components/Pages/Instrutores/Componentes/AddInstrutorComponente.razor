@using GinasioVitaFit.Shared.Models
@using GinasioVitaFit.Shared.Services
@using MudBlazor
@inject IGinasioVitaFitService GinasioService
@inject ISnackbar Snackbar

@if (_isOpen)
{
<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; animation: fadeIn 0.2s ease-in-out;">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl mx-4 overflow-hidden" style="border-top: 6px solid #FF6B00; color: black;" @onclick:stopPropagation>

        @if (_isLoading)
        {
        <div class="flex flex-col items-center justify-center py-16">
            <div style="width: 48px; height: 48px; border: 4px solid #FF6B00; border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <p class="mt-4 text-gray-500 font-bold">@(_isEdicao ? "A atualizar dados..." : "A gravar instrutor...")</p>
        </div>
        }
        else
        {
        <!-- IMPLEMENTAÇÃO DO REQUISITO: EditForm nativo com validação de C# DataAnnotations -->
        <EditForm Model="@novoInstrutor" OnValidSubmit="SubmeterFormulario">
            <DataAnnotationsValidator />

            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
                <h3 class="text-xl font-bold text-gray-800">
                    <MudIcon Icon="@(_isEdicao ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Class="mr-2" Style="color: #FF6B00;" />
                    @(_isEdicao ? "Editar Dados do Instrutor" : "Adicionar Instrutor")
                </h3>
                <button type="button" @onclick="Hide" class="p-2 text-gray-400 hover:text-gray-600 transition cursor-pointer">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>

            <div class="px-6 py-4" style="max-height: 70vh; overflow-y: auto;">
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="Nome Completo" @bind-Value="novoInstrutor.Name" For="@(() => novoInstrutor.Name)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Email" @bind-Value="novoInstrutor.Email" For="@(() => novoInstrutor.Email)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Contacto" @bind-Value="novoInstrutor.Contacto" For="@(() => novoInstrutor.Contacto)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Modalidade" Label="Modalidades"
                                   MultiSelection="true"
                                   SelectedValues="_chosenMods"
                                   ToStringFunc="modalidade => modalidade.Name"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Phone">
                            @foreach (Modalidade mod in _listMod)
                            {
                                <MudSelectItem T="Modalidade" Value="@mod">@mod.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </div>

            <div class="flex justify-end gap-4 px-6 py-4 border-t border-gray-100 bg-gray-50">
                <!-- O botão agora é do tipo submit para acionar o EditForm automaticamente -->
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Style="background-color: #FF6B00; color: white; font-weight: bold; border-radius: 6px;" StartIcon="@Icons.Material.Filled.Save">
                    @(_isEdicao ? "Atualizar" : "Gravar")
                </MudButton>
            </div>
        </EditForm>
        }
    </div>
</div>
}

@code {
    private Instrutor novoInstrutor = new Instrutor { ImageUrl = "default.png" };

    private bool _isOpen = false;
    private bool _isLoading = false;
    private bool _isEdicao = false;

    private List<Modalidade> _listMod = new List<Modalidade>();
    private List<Modalidade> _chosenMods = new List<Modalidade>();

    [Parameter] public EventCallback OnSubmetido { get; set; }
    
    public void Show()
    {
        _isEdicao = false;
        _isOpen = true;
        _isLoading = false;
        novoInstrutor = new Instrutor { ImageUrl = "default.png" };
        CarregarDados();
        StateHasChanged();
    }

    public async Task ShowEditar(Instrutor instrutorParaEditar)
    {
        _isEdicao = true;
        _isOpen = true;
        _isLoading = false;

        novoInstrutor = instrutorParaEditar;
        

        if (_isEdicao)
        {
            var mods = await GinasioService.GetAllModalidadesFromInstrutor(novoInstrutor.Id);

            if (mods.IsSuccessStatusCode)
            {
                List<InstrutorMod> instMods = mods.Content ?? new List<InstrutorMod>();
                foreach (var im in instMods)
                {
                    var mod = await GinasioService.GetModalidade(im.ModalidadeId);
                    Modalidade resultmod = mod.Content ?? new Modalidade();
                    
                    _chosenMods.Add(resultmod);
                }
            }
        }
        
        await CarregarDados();
        StateHasChanged();
    }

    private async Task CarregarDados()
    {
        var mods = await GinasioService.GetAllModalidades();

        if (mods.IsSuccessStatusCode)
            _listMod = mods.Content ?? new List<Modalidade>();
            
    }

    public void Hide()
    {
        _isOpen = false;
        StateHasChanged();
    }

// Como o EditForm só dispara este método se o formulário for 100% válido, removemos a validação manual antiga!
    private async Task SubmeterFormulario()
    {
        List<InstrutorMod> ModalidadesToSend = new List<InstrutorMod>();
        
        _isLoading = true;
        StateHasChanged();

        try
        {
            HttpResponseMessage? resposta;

            if (_isEdicao)
            {
                resposta = await GinasioService.UpdateInstrutor(novoInstrutor);
            }
            else
            {
                resposta = await GinasioService.AddInstrutor(novoInstrutor);
                
                /*
                foreach (Modalidade cm in _chosenMods)
                {
                    InstrutorMod im = new InstrutorMod()
                    {
                    
                    };
                    
                    ModalidadesToSend.Add(im);
                }
                */
            }

            if (resposta != null && resposta.IsSuccessStatusCode)
            {
                Snackbar.Add(_isEdicao ? "Dados atualizados com sucesso!" : "Instrutor registado com sucesso!", Severity.Success);

                
                await Task.Delay(500);
                _isOpen = false;
                await OnSubmetido.InvokeAsync();
            }
            else
            {
                Snackbar.Add("Erro ao comunicar com a API", Severity.Error);
                _isLoading = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
            _isLoading = false;
        }

        StateHasChanged();
    }
}
