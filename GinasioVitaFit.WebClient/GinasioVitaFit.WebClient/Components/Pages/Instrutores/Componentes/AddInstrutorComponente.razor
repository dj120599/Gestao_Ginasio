@using System.Diagnostics
@using System.Text
@using GinasioVitaFit.Shared.Models
@using GinasioVitaFit.Shared.Services
@using MudBlazor
@inject IGinasioVitaFitService GinasioService
@inject ISnackbar Snackbar

@if (_isOpen)
{
<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center; animation: fadeIn 0.2s ease-in-out;">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl mx-4 overflow-hidden" style="border-top: 6px solid #FF6B00; color: black;" @onclick:stopPropagation>

        @if (_isLoading)
        {
            <div class="flex flex-col items-center justify-center py-16">
                <div style="width: 48px; height: 48px; border: 4px solid #FF6B00; border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite;"></div>
                <p class="mt-4 text-gray-500 font-bold">@(_isEdicao ? "A atualizar dados..." : "A gravar instrutor...")</p>
            </div>
        }
        else
        {
            <!-- IMPLEMENTAÇÃO DO REQUISITO: EditForm nativo com validação de C# DataAnnotations -->
            <EditForm Model="@_novoInstrutorDto" OnValidSubmit="SubmeterFormulario">
                <DataAnnotationsValidator />

                <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
                    <h3 class="text-xl font-bold text-gray-800">
                        <MudIcon Icon="@(_isEdicao ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Class="mr-2" Style="color: #FF6B00;" />
                        @(_isEdicao ? "Editar Dados do Instrutor" : "Adicionar Instrutor")
                    </h3>
                    <button type="button" @onclick="Hide" class="p-2 text-gray-400 hover:text-gray-600 transition cursor-pointer">
                        <MudIcon Icon="@Icons.Material.Filled.Close" />
                    </button>
                </div>

                <div class="px-6 py-4" style="max-height: 70vh; overflow-y: auto;">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Nome Completo" @bind-Value="_novoInstrutorDto.Name" For="@(() => _novoInstrutorDto.Name)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
                        </MudItem>
                        <!-- REPOSIÇÃO DO CAMPO DE URL DA IMAGEM -->
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="URL da Foto (Link da Imagem)" @bind-Value="_novoInstrutorDto.ImageUrl" For="@(() => _novoInstrutorDto.ImageUrl)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Image" Placeholder="Cole o link da imagem..." Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Email" @bind-Value="_novoInstrutorDto.Email" For="@(() => _novoInstrutorDto.Email)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="Contacto" @bind-Value="_novoInstrutorDto.Contacto" For="@(() => _novoInstrutorDto.Contacto)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="MultiSelectItem2" Label="Modalidades"
                                       MultiSelection="true"
                                       SelectedValues="@_SelectedMods"
                                       SelectedValuesChanged="Callback"
                                       ToStringFunc="@ToString"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Phone">
                                @foreach (MultiSelectItem2 item in _listMSI)
                                {
                                    <MudSelectItem Value="@item"/>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </div>

                <div class="flex justify-end gap-4 px-6 py-4 border-t border-gray-100 bg-gray-50">
                    <!-- O botão agora é do tipo submit para acionar o EditForm automaticamente -->
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Style="background-color: #FF6B00; color: white; font-weight: bold; border-radius: 6px;" StartIcon="@Icons.Material.Filled.Save">
                        @(_isEdicao ? "Atualizar" : "Gravar")
                    </MudButton>
                </div>
            </EditForm>
        }
    </div>
</div>
}

@code {
    private InstrutorDto _novoInstrutorDto = new InstrutorDto { ImageUrl = "default.png" };
    
    private bool _isOpen = false;
    private bool _isLoading = false;
    private bool _isEdicao = false;
    
    public class MultiSelectItem2
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public override bool Equals(object o) {
            var other = o as MultiSelectItem2;
            return other?.Id==Id;
        }
        public override int GetHashCode() => Id.GetHashCode();
    }
    
    private List<MultiSelectItem2> _listMSI = new();
    private List<MultiSelectItem2> _SelectedMods = new();
    
    private List<ModalidadeDto> _listMod = new();
    private List<ModalidadeDto> _listModToSend = new();
    
    [Parameter] public EventCallback OnSubmetido { get; set; }

    
    public async Task Show()
    {
        _isEdicao = false;
        _isOpen = true;
        _isLoading = false;
        _novoInstrutorDto = new InstrutorDto { ImageUrl = "default.png" };
        
        _SelectedMods.Clear();
        
        await CarregarDados();
        StateHasChanged();
    }

    public async Task ShowEditar(InstrutorDto instrutorDtoParaEditar)
    {
        _isEdicao = true;
        _isOpen = true;
        _isLoading = false;

        novoInstrutor =  instrutorParaEditar;
        var mods = await GinasioService.GetAllModalidadesFromInstrutor(instrutorParaEditar.Id);
            List<InstrutorMod> templist = mods.Content ?? new List<InstrutorMod>();
            foreach (var tl in templist)
            {
                InstrutorMod im = new InstrutorMod()
                {
                    InstrutorId = tl.InstrutorId,
                    ModalidadeId = tl.ModalidadeId
                };
                    
                _ModsFromInst.Add(im);
            }
            
            foreach (var im in _ModsFromInst)
            {
                var mod = await GinasioService.GetModalidade(im.ModalidadeId);
                Modalidade resultmod = mod.Content ?? new Modalidade();
                    
                //_chosenMods.Add(resultmod);
                MultiSelectItem m2 = From1To2(resultmod);
                SelectedMods.Add(m2); 
            }
        
        
        await CarregarDados();
        StateHasChanged();
    }

    MultiSelectItem2 From1To2(ModalidadeDto resultmod)
    {
        MultiSelectItem2 m2 = new MultiSelectItem2()
        {
            Id = resultmod.Id,
            Name = resultmod.Name
        };

        return m2;
    }
    ModalidadeDto From2To1(MultiSelectItem2 resultmod)
    {
        ModalidadeDto m2 = new ModalidadeDto()
        {
            Id = resultmod.Id,
            Name = resultmod.Name
        };

        return m2;
    }

    private async Task CarregarDados()
    {
        _listMSI.Clear();
        _listMod.Clear();
        
        List<ModalidadeDto> interModList = new();
        
        var mods = await GinasioService.GetAllModalidades();

        if (mods.IsSuccessStatusCode)
            interModList = mods.Content ?? new List<ModalidadeDto>();

        foreach (ModalidadeDto _mod in interModList)
        {
            _listMod.Add(_mod);
            _listMSI.Add(From1To2(_mod));
        }
        
    }

    public void Hide()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task SubmeterFormulario()
    {
        _listModToSend.Clear();
        
        _isLoading = true;
        StateHasChanged();

        foreach (var modality in _SelectedMods)
        {
            ModalidadeDto mod = _listMod.FirstOrDefault(m => m.Id == modality.Id);
            _listModToSend.Add(mod);
        }

        _novoInstrutorDto.Modalidades = _listModToSend;
        try
        {
            HttpResponseMessage? resposta;

            if (_isEdicao)
            {
                resposta = await GinasioService.UpdateInstrutor(_novoInstrutorDto);
            }
            else
            {
                resposta = await GinasioService.AddInstrutor(_novoInstrutorDto);
            }

            if (resposta != null && resposta.IsSuccessStatusCode)
            {
                
                Snackbar.Add("Dados atualizados com sucesso!", Severity.Success);

                Snackbar.Add(_isEdicao ? "Dados atualizados com sucesso!" : "InstrutorDto registado com sucesso!", Severity.Success);
                await Task.Delay(500);
                _isOpen = false;
                
                _isLoading = false;
                await OnSubmetido.InvokeAsync();
            }
            else
            {
                Snackbar.Add("Erro ao comunicar com a API", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
            _isLoading = false;
        }
        
        StateHasChanged();    
    }
    
    private string ToString(MultiSelectItem2 x)
        => x is null ? string.Empty : $"{x.Name}";
    
    private void Callback(IReadOnlyCollection<MultiSelectItem2> obj)
    {
        List<MultiSelectItem2> msi = new();
        
        foreach (var var in obj)
        {
            msi.Add(var);
        }

        _SelectedMods = msi;
    }
}
