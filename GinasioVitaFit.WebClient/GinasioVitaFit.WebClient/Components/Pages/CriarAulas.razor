                                         AdornmentIcon="@Icons.Material.Filled.Groups" />
                    </MudItem>
        -->

                </MudGrid>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-center mt-4">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Large" 
                       OnClick="SubmeterFormulario">
                Gravar Aula
            </MudButton>
        </MudCardActions>
        
    </MudCard>
</MudContainer>

@code {
    [Parameter]
    public int? Id { get; set; } 
    
    private MudForm form;
    
    private Aula novaAula = new Aula { Capacidade = 10 }; 
   
    private DateTime? dataSelecionada = DateTime.Today;
    private TimeSpan? horaInicio = new TimeSpan(09, 00, 00);
    private TimeSpan? horaFim = new TimeSpan(10, 00, 00);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

    }
    
    private async Task SubmeterFormulario()
    {
        if (form == null) return;
        
        await form.Validate();

        if (form.IsValid)
        {
            if (dataSelecionada == null || horaInicio == null || horaFim == null)
            {
                novaAula.AulaInicio = dataSelecionada.Value.Date + horaInicio.Value;
                novaAula.AulaFim = dataSelecionada.Value.Date + horaFim.Value;
            }
            
            if (novaAula.AulaFim <= novaAula.AulaInicio)
            {
                Snackbar.Add("Erro: A hora de fim deve ser posterior à hora de início!", Severity.Error);
                return;
            }

            try
            {
                novaAula.AulaInicio = dataSelecionada.Value.Date + horaInicio.Value;
                novaAula.AulaFim = dataSelecionada.Value.Date + horaFim.Value;

                if (novaAula.AulaFim <= novaAula.AulaInicio)
                {
                    Snackbar.Add("Erro: A hora de fim deve ser posterior à hora de início!", Severity.Error);
                    return;
                }
                
                var resposta = await GinasioService.AddAula(novaAula);

                if (resposta.IsSuccessStatusCode)
                {
                    Snackbar.Add("Aula registada com sucesso!", Severity.Success);
                    await ResetarFormulario();
                    Navigation.NavigateTo("/ListarAulas");
                }
                else
                {
                    var erroTexto = resposta.ReasonPhrase ?? "Erro desconhecido";
                    Snackbar.Add($"Erro da API ({resposta.StatusCode}): {erroTexto}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erro de ligação à API: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ResetarFormulario()
    {
        novaAula = new Aula { Capacidade = 10 }; 
        dataSelecionada = DateTime.Today;
        horaInicio = new TimeSpan(09, 00, 00);
        horaFim = new TimeSpan(10, 00, 00);

        if (form != null)
        {
            await form.ResetValidationAsync();
        }
    }
}